<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <!-- Keep registry demos separate from caches used by local publishing tests. -->
    <add key="globalPackagesFolder" value=".artifacts/nuget-registry" />
  </config>
</configuration>
